--- lib/DateTime/Format/CLDR.pm
+++ lib/DateTime/Format/CLDR.pm
@@ -957,7 +957,12 @@
     return $quote
         if ref($quote) eq 'Regexp';
 
-    $quote =~ s/([^[:alnum:][:space:]])/\\$1/g;
+    # Backslashing each byte of an undecoded UTF-8 literal creates invalid
+    # byte sequences between the slashes. Explicit code-point escapes work
+    # for both byte strings and decoded Unicode strings.
+    $quote =~ s/([^[:alnum:][:space:]])/
+        ord($1) > 127 ? sprintf('\\x{%x}', ord($1)) : "\\$1"
+    /gex;
     $quote =~ s/\s+/\\s+/g;
     return $quote;
 }

--- lib/WWW/Form/UrlEncoded/PP.pm.orig
+++ lib/WWW/Form/UrlEncoded/PP.pm
@@ -105,13 +105,24 @@
     return '' unless defined $_[0];
     my $t = shift;
     utf8::encode($t) if $NEED_UPGRADE;
-    {
-        use bytes;
-        $t =~ s!([^A-Za-z0-9\-\._~])!
-            join '',@EncodeMap{exists $EncodeMap{$1} ? ($1) : (split //,$1)}
-        !gsxe;
+    # Perl's `use bytes` makes a UTF-8 flagged scalar expose its encoded
+    # octets to the substitution above. PerlOnJava keeps the scalar content
+    # in a Java String, so perform that conversion explicitly before walking
+    # the bytes. This preserves byte-string input while encoding Unicode
+    # characters exactly as the upstream pure-Perl implementation does.
+    utf8::encode($t) if utf8::is_utf8($t);
+    my $encoded = '';
+    for my $octet (split //, $t) {
+        if ($octet =~ /[^A-Za-z0-9\-\._~]/) {
+            $encoded .= ($octet eq ' ')
+                ? '+'
+                : $EncodeMap{$octet};
+        }
+        else {
+            $encoded .= $octet;
+        }
     }
-    return $t;
+    return $encoded;
 }
